# ─── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8010
WEB_BASE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=salesrobo
POSTGRES_PASSWORD=salesrobo_dev_password
POSTGRES_DB=salesrobo
# Used by the api/worker containers (host `postgres` = compose service name)
DATABASE_URL=postgresql+asyncpg://salesrobo:salesrobo_dev_password@postgres:5432/salesrobo

# ─── Redis (Celery broker + locks + quota buckets) ───────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_dev_only_secret_do_not_use_in_production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ─── Secret encryption (LinkedIn sessions, proxy creds, mailbox creds) ───────
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_real_fernet_key_before_use=

# ─── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=salesrobo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── AI ──────────────────────────────────────────────────────────────────────
# ── LinkedIn publishing (official API) ───────────────────────────────────────
# Credentials of a LinkedIn developer app with the "Share on LinkedIn" product
# enabled. Required for Content Studio publishing; leave blank and the product
# reports publishing as unavailable rather than pretending to publish.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8010/api/v1/linkedin/oauth/callback
LINKEDIN_API_VERSION=202409
LINKEDIN_PUBLISHING_SCOPES=openid profile w_member_social

ANTHROPIC_API_KEY=
# Inbox AI assistant: tried in order until one answers (openai, gemini, anthropic)
AI_ASSISTANT_PROVIDERS=openai,gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_GENERATION_MODEL=claude-opus-5
AI_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# ─── Billing ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Proxies (Phase 2) ───────────────────────────────────────────────────────
PROXY_PROVIDER=none
PROXY_PROVIDER_USERNAME=
PROXY_PROVIDER_PASSWORD=
PROXY_PROVIDER_HOST=
PROXY_PROVIDER_PORT=

# ─── Safety engine defaults (per LinkedIn account, overridable in-app) ───────
SAFETY_DEFAULT_TEST_MODE=true
SAFETY_TEST_MODE_DAILY_INVITES=3
SAFETY_MAX_DAILY_INVITES=75
SAFETY_MAX_WEEKLY_INVITES=100
SAFETY_MIN_ACTION_GAP_SECONDS=45
SAFETY_MEDIAN_ACTION_GAP_SECONDS=240
SAFETY_MAX_ACTION_GAP_SECONDS=1500

# ─── Frontend (build-time) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
