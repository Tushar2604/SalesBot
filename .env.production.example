# Copy to .env.production on the server and fill in. Never commit the copy.
# Generate every secret fresh for production — never reuse development ones:
#   hex secrets:    openssl rand -hex 32
#   ENCRYPTION_KEY: docker run --rm python:3.12-slim sh -c \
#                     "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# ENCRYPTION_KEY protects stored LinkedIn sessions and proxy passwords. Back it
# up somewhere safe: lose it and every account must be reconnected.

# ── domains (both need a DNS A record pointing at this server) ──────────────
APP_DOMAIN=app.example.com
FILES_DOMAIN=files.example.com
ACME_EMAIL=you@example.com

# ── secrets ─────────────────────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=salesrobo
S3_SECRET_KEY=

# ── AI (at least one provider key, or the assistant stays silent) ───────────
AI_ASSISTANT_PROVIDERS=openai,gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── optional ────────────────────────────────────────────────────────────────
# Official LinkedIn API for Content Studio publishing. Redirect URI to register
# in the LinkedIn developer app: https://APP_DOMAIN/api/v1/linkedin/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Use real S3 / Cloudflare R2 instead of the bundled MinIO:
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
